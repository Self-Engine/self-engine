<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs JIT memory under the hardened runtime. Nothing else: Electron's frameworks and
         every helper are signed with the same Developer ID, so library validation stays on. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
